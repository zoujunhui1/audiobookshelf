# Copy relevant values into your own shell env (or into the Node side's dev.js) before
# running either server. Do not commit a real .env file.
#
# IMPORTANT: the four vars under "shared with Node" must have the SAME value on both
# the Node.js server (server/, started via `npm run dev`) and this Go server. If they
# differ, a token issued by one side will fail to validate on the other — see the
# go-rewrite-dev skill for why this matters (JWT secret + token expiry parity).

# --- shared with Node (server/Auth.js + server/auth/TokenManager.js) ---
JWT_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRY=3600        # seconds. Node default if unset: 3600 (1 hour)
REFRESH_TOKEN_EXPIRY=2592000    # seconds. Node default if unset: 2592000 (30 days)
REFRESH_TOKEN_GRACE_PERIOD=600  # seconds. Node default if unset: 600 (10 minutes)

# --- Go side only ---
GO_SERVER_PORT=4000
# Same file Node opens at <CONFIG_PATH>/absdatabase.sqlite (CONFIG_PATH defaults to
# "config" at the repo root, see index.js). Adjust if your CONFIG_PATH is not default.
DB_PATH=../config/absdatabase.sqlite
